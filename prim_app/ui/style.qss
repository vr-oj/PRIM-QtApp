/* Base window background */
QMainWindow {
    background-color: #1e1e1e;
    color: #ffffff;
    font-family: "Segoe UI", sans-serif;
    font-size: 11pt;
}

/* Menu bar */
QMenuBar {
    background-color: #2c2c2c;
    color: #ffffff;
}
QMenuBar::item:selected {
    background-color: #3d3d3d;
}

/* Group boxes */
QGroupBox {
    border: 1px solid #444;
    border-radius: 5px;
    margin-top: 6px;
    font-weight: bold;
    color: #e0e0e0;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
}

/* Labels */
QLabel {
    color: #dddddd;
}

/* Buttons */
QPushButton {
    background-color: #444;
    color: white;
    border: 1px solid #666;
    border-radius: 4px;
    padding: 5px 10px;
}
QPushButton:hover {
    background-color: #666;
    border: 1px solid #888;
}
QPushButton:disabled {
    background-color: #2e2e2e;
    color: #777;
}

/* ComboBoxes */
QComboBox {
    background-color: #2e2e2e;
    color: white;
    border: 1px solid #555;
    border-radius: 4px;
    padding: 4px;
}

/* SpinBoxes, LineEdits */
QLineEdit, QSpinBox, QDoubleSpinBox {
    background-color: #2a2a2a;
    color: #ffffff;
    border: 1px solid #555;
    border-radius: 4px;
    padding: 3px;
}

/* Tab widgets */
QTabWidget::pane {
    border: 1px solid #444;
    padding: 5px;
}
QTabBar::tab {
    background: #2c2c2c;
    color: #ccc;
    padding: 5px 10px;
    border: 1px solid #444;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}
QTabBar::tab:selected {
    background: #444;
    color: white;
}

/* Plot canvas border */
QWidget#plotCanvas {
    border: 1px solid #555;
    background-color: #101010;
}

/* Plot export button specifically */
QPushButton#exportPlotButton {
    background-color: #2f6fad;
    border: 1px solid #4185d0;
}
QPushButton#exportPlotButton:hover {
    background-color: #3e7fd6;
}
