/* Base font and palette */
QWidget {
    font-family: 'Segoe UI', sans-serif;
    font-size: 10pt;
}

/* Group boxes appear as cards with subtle border */
QGroupBox {
    background-color: #3a3a3a;
    border: 1px solid #555;
    border-radius: 6px;
    margin-top: 6px;
    padding: 6px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    top: -6px;
    padding: 0 4px;
    font-weight: bold;
}

/* Flat push button styling */
QPushButton {
    background-color: #444;
    color: white;
    border: 1px solid #666;
    border-radius: 4px;
    padding: 6px 12px;
}
QPushButton:hover {
    background-color: #666;
}
QPushButton:pressed {
    background-color: #222;
}

/* Status badges */
QLabel[status="connected"] {
    color: white;
    background-color: #4caf50;
    border-radius: 8px;
    padding: 2px 8px;
}
QLabel[status="disconnected"], QLabel[status="error"] {
    color: white;
    background-color: #f44336;
    border-radius: 8px;
    padding: 2px 8px;
}

/* Pressure value emphasis */
QLabel#pressureValue {
    font-size: 12pt;
    font-weight: bold;
}
