/* Global font and colors */
* {
    font-family: 'Segoe UI', sans-serif;
    font-size: 10pt;
    color: #dddddd;
}

QMainWindow {
    background-color: #2b2b2b;
}

/* Group boxes styled as subtle cards */
QGroupBox {
    border: 1px solid #555555;
    border-radius: 6px;
    margin-top: 6px;
    padding: 6px;
    background-color: #3a3a3a;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
}

/* Flat-style buttons with hover/pressed states */
QPushButton {
    background-color: #444444;
    color: white;
    border: 1px solid #666666;
    border-radius: 4px;
    padding: 6px 12px;
}
QPushButton:hover {
    background-color: #666666;
}
QPushButton:pressed {
    background-color: #222222;
}

/* Status label badges */
QLabel[status="connected"] {
    color: white;
    background-color: #4caf50;
    border-radius: 8px;
    padding: 2px 8px;
}
QLabel[status="disconnected"], QLabel[status="error"] {
    color: white;
    background-color: #f44336;
    border-radius: 8px;
    padding: 2px 8px;
}
